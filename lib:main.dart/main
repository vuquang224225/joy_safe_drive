import 'package:flutter/material.dart';
import 'package:url_launcher/url_launcher.dart';
import 'package:geolocator/geolocator.dart';
import 'dart:async';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const JoySafeDriveApp());
}

const navy = Color(0xFF0B1424);
const panel = Color(0xFF14243A);
const green = Color(0xFF72E6A2);
const muted = Color(0xFFA8B7CC);
const orange = Color(0xFFFFBF69);

class JoySafeDriveApp extends StatelessWidget {
  const JoySafeDriveApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Joy Safe Drive',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: navy,
        colorScheme: ColorScheme.fromSeed(
          seedColor: green,
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int selectedTab = 0;
  double currentSpeed = 0.0;
  double latitude = 0.0;
  double longitude = 0.0;
  double accuracy = 0.0;
  bool isTracking = false;
  StreamSubscription<Position>? positionStream;

  @override
  void dispose() {
    positionStream?.cancel();
    super.dispose();
  }

  Future<void> toggleGpsTracking() async {
    bool serviceEnabled;
    LocationPermission permission;

    if (isTracking) {
      positionStream?.cancel();
      setState(() {
        isTracking = false;
        currentSpeed = 0.0;
      });
      return;
    }

    serviceEnabled = await Geolocator.isLocationServiceEnabled();
    if (!serviceEnabled) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('GPS chưa được bật trên thiết bị.')),
      );
      return;
    }

    permission = await Geolocator.checkPermission();
    if (permission == LocationPermission.denied) {
      permission = await Geolocator.requestPermission();
      if (permission == LocationPermission.denied) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Quyền truy cập vị trí bị từ chối.')),
        );
        return;
      }
    }

    if (permission == LocationPermission.deniedForever) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Quyền vị trí bị từ chối vĩnh viễn trong cài đặt.')),
      );
      return;
    }

    setState(() {
      isTracking = true;
    });

    const LocationSettings locationSettings = LocationSettings(
      accuracy: LocationAccuracy.bestForNavigation,
      distanceFilter: 1,
    );

    positionStream = Geolocator.getPositionStream(locationSettings: locationSettings).listen(
      (Position position) {
        setState(() {
          latitude = position.latitude;
          longitude = position.longitude;
          accuracy = position.accuracy;
          
          // Giả lập tốc độ cố định 48 km/h cho Simulator
          currentSpeed = 48.0; 
        });
      },
      onError: (e) {
        setState(() {
          isTracking = false;
        });
      },
    );
  }

  Future<void> openMap() async {
    final uri = Uri.parse(
      'https://www.google.com/maps/dir/?api=1&destination=Ho+Chi+Minh+City',
    );

    if (!await launchUrl(
      uri,
      mode: LaunchMode.externalApplication,
    )) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Chưa mở được bản đồ.')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: IndexedStack(
          index: selectedTab,
          children: [
            buildHome(),
            buildAlerts(),
            buildGuide(),
            buildDevices(),
          ],
        ),
      ),
      bottomNavigationBar: NavigationBar(
        backgroundColor: panel,
        indicatorColor: green.withValues(alpha: 0.18),
        selectedIndex: selectedTab,
        onDestinationSelected: (index) {
          setState(() => selectedTab = index);
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home, color: green),
            label: 'Trang chủ',
          ),
          NavigationDestination(
            icon: Icon(Icons.warning_amber_rounded),
            label: 'Cảnh báo',
          ),
          NavigationDestination(
            icon: Icon(Icons.health_and_safety_outlined),
            label: 'Hướng xử lý',
          ),
          NavigationDestination(
            icon: Icon(Icons.sensors_outlined),
            label: 'Thiết bị',
          ),
        ],
      ),
    );
  }

  Widget buildHome() {
    return ListView(
      padding: const EdgeInsets.fromLTRB(20, 18, 20, 28),
      children: [
        Row(
          children: [
            Container(
              padding: const EdgeInsets.all(11),
              decoration: BoxDecoration(
                color: panel,
                borderRadius: BorderRadius.circular(15),
              ),
              child: const Icon(
                Icons.shield_rounded,
                color: green,
                size: 30,
              ),
            ),
            const SizedBox(width: 12),
            const Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'JOY SAFE DRIVE',
                    style: TextStyle(
                      fontSize: 20,
                      fontWeight: FontWeight.w900,
                      letterSpacing: 1,
                    ),
                  ),
                  SizedBox(height: 4),
                  Text(
                    'AN TOÀN TRÊN MỌI HÀNH TRÌNH',
                    style: TextStyle(fontSize: 9, color: muted),
                  ),
                ],
              ),
            ),
            const Icon(Icons.notifications_none, color: muted, size: 27),
          ],
        ),
        const SizedBox(height: 26),
        Container(
          padding: const EdgeInsets.all(22),
          decoration: BoxDecoration(
            gradient: const LinearGradient(
              colors: [Color(0xFF1B3550), panel],
              begin: Alignment.topLeft,
              end: Alignment.bottomRight,
            ),
            borderRadius: BorderRadius.circular(25),
            border: Border.all(color: Colors.white10),
          ),
          child: Column(
            children: [
              const Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text(
                    'TỐC ĐỘ HIỆN TẠI (GPS)',
                    style: TextStyle(
                      color: muted,
                      fontSize: 12,
                      letterSpacing: 1,
                    ),
                  ),
                  StatusPill(),
                ],
              ),
              const SizedBox(height: 12),
              Row(
                mainAxisAlignment: MainAxisAlignment.center,
                crossAxisAlignment: CrossAxisAlignment.baseline,
                textBaseline: TextBaseline.alphabetic,
                children: [
                  Text(
                    isTracking ? currentSpeed.toStringAsFixed(0) : '--',
                    style: const TextStyle(
                      fontSize: 65,
                      height: 1.15,
                      fontWeight: FontWeight.w300,
                    ),
                  ),
                  const SizedBox(width: 8),
                  const Text('km/h', style: TextStyle(color: muted)),
                ],
              ),
              const SizedBox(height: 12),
              const Divider(color: Colors.white12),
              const SizedBox(height: 8),
              if (isTracking) ...[
                Text(
                  'Lat: ${latitude.toStringAsFixed(5)} | Lng: ${longitude.toStringAsFixed(5)}',
                  style: const TextStyle(color: green, fontSize: 12, fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 4),
                Text(
                  'Độ chính xác: ~${accuracy.toStringAsFixed(1)}m',
                  style: const TextStyle(color: muted, fontSize: 11),
                ),
                const SizedBox(height: 8),
              ],
              Icon(
                isTracking ? Icons.gps_fixed : Icons.gps_off,
                color: isTracking ? green : muted,
                size: 22,
              ),
              const SizedBox(height: 8),
              Text(
                isTracking ? 'Đang theo dõi GPS thực tế' : 'Chưa bật theo dõi GPS',
                style: TextStyle(
                  color: isTracking ? green : muted,
                  fontWeight: FontWeight.w600,
                ),
              ),
              const SizedBox(height: 14),
              SizedBox(
                width: double.infinity,
                child: OutlinedButton.icon(
                  onPressed: toggleGpsTracking,
                  icon: Icon(isTracking ? Icons.stop : Icons.play_arrow),
                  label: Text(isTracking ? 'DỪNG GPS' : 'BẬT GPS NGAY'),
                  style: OutlinedButton.styleFrom(
                    foregroundColor: isTracking ? orange : green,
                    side: BorderSide(color: isTracking ? orange : green),
                    padding: const EdgeInsets.symmetric(vertical: 12),
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 25),
        const SectionTitle(
          title: 'Hành trình của bạn',
          subtitle: 'Chuẩn bị cho chuyến đi an toàn hơn',
        ),
        const SizedBox(height: 13),
        Container(
          padding: const EdgeInsets.all(18),
          decoration: BoxDecoration(
            color: panel,
            borderRadius: BorderRadius.circular(22),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Container(
                height: 105,
                width: double.infinity,
                decoration: BoxDecoration(
                  color: const Color(0xFF1B3046),
                  borderRadius: BorderRadius.circular(15),
                ),
                child: const Center(
                  child: Icon(
                    Icons.map_outlined,
                    color: green,
                    size: 48,
                  ),
                ),
              ),
              const SizedBox(height: 15),
              const Text(
                'Bản đồ & chỉ đường',
                style: TextStyle(fontSize: 17, fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 6),
              const Text(
                'Mở bản đồ để tìm đường và chuẩn bị điểm đến.',
                style: TextStyle(color: muted, fontSize: 13),
              ),
              const SizedBox(height: 16),
              SizedBox(
                width: double.infinity,
                child: FilledButton.icon(
                  onPressed: openMap,
                  icon: const Icon(Icons.near_me),
                  label: const Text('MỞ GOOGLE MAPS'),
                  style: FilledButton.styleFrom(
                    backgroundColor: green,
                    foregroundColor: navy,
                    padding: const EdgeInsets.symmetric(vertical: 15),
                  ),
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }

  Widget buildAlerts() => const InformationPage(icon: Icons.warning_amber_rounded, title: 'Trung tâm cảnh báo', subtitle: 'Nhận biết nguy cơ, chủ động bảo vệ hành trình.', items: []);
  Widget buildGuide() => const InformationPage(icon: Icons.health_and_safety_outlined, title: 'Hướng xử lý an toàn', subtitle: 'Nguyên tắc cơ bản.', items: []);
  Widget buildDevices() => const InformationPage(icon: Icons.sensors_outlined, title: 'Thiết bị tương thích', subtitle: 'Mở rộng trong tương lai.', items: []);
}

class StatusPill extends StatelessWidget {
  const StatusPill({super.key});
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
      decoration: BoxDecoration(
        color: orange.withValues(alpha: 0.13),
        borderRadius: BorderRadius.circular(20),
      ),
      child: const Text('BẢN THỬ NGHIỆM', style: TextStyle(color: orange, fontSize: 9, fontWeight: FontWeight.bold)),
    );
  }
}

class SectionTitle extends StatelessWidget {
  final String title;
  final String subtitle;
  const SectionTitle({super.key, required this.title, required this.subtitle});
  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(title, style: const TextStyle(fontSize: 19, fontWeight: FontWeight.bold)),
        const SizedBox(height: 5),
        Text(subtitle, style: const TextStyle(color: muted, fontSize: 12)),
      ],
    );
  }
}

class InformationPage extends StatelessWidget {
  final IconData icon;
  final String title;
  final String subtitle;
  final List<dynamic> items;
  const InformationPage({super.key, required this.icon, required this.title, required this.subtitle, required this.items});
  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        Icon(icon, color: green, size: 42),
        const SizedBox(height: 16),
        Text(title, style: const TextStyle(fontSize: 26, fontWeight: FontWeight.bold)),
        const SizedBox(height: 8),
        Text(subtitle, style: const TextStyle(color: muted, height: 1.5)),
      ],
    );
  }
}